FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /bin/uv
WORKDIR /app/backend
ENV UV_PYTHON_DOWNLOADS=never

COPY backend/pyproject.toml backend/uv.lock backend/README.md ./
RUN uv sync --locked --no-dev --no-install-project
COPY backend/src ./src
RUN uv sync --locked --no-dev --no-editable

COPY exercises.mongodb.json /app/exercises.mongodb.json
COPY scripts/seed_exercises.py /app/scripts/seed_exercises.py
ENTRYPOINT ["/app/backend/.venv/bin/python", "/app/scripts/seed_exercises.py"]
CMD ["--file", "/app/exercises.mongodb.json"]
